filters:
  and:
    - file.ext == "md"
    - formula.section != "tags"
    - file.name != "404"
    - "!formula.Data.isEmpty()"
    - file.folder != "private"
formulas:
  doc_type: |
    if(file.hasTag("teologia"), "teologia",
    if(file.hasTag("formacao"), "formação",
    if(file.inFolder("formacao"), "formação",
    if(file.inFolder("teologia"), "teologia",
    if(file.inFolder("programador"), "programador",
    if(file.inFolder("cli"), "cli", "guia"))))))
  last_modified: file.mtime.relative()
  section: |
    if(file.inFolder("Formacao"), "formação",
    if(file.inFolder("teologia"), "teologia",
    if(file.inFolder("programador"), "programador",
    if(file.inFolder("tags"), "tags", "core"))))
  Data: (file.mtime).format("MM-DD")
  days_alive: (today() - file.mtime).days.ceil()
properties:
  title:
    displayName: Título
  formula.doc_type:
    displayName: Tipo
  formula.last_modified:
    displayName: Atualizado
  formula.section:
    displayName: Seção
  note.title:
    displayName: Título
  description:
    displayName: descrição
  formula.days_alive:
    displayName: Dias atrás
views:
  - type: list
    name: Atualizado recentemente
    order:
      - file.name
      - formula.last_modified
    limit: 20
  - type: cards
    name: Cards
    order:
      - file.name
      - formula.section
      - formula.last_modified
    sort:
      - property: formula.last_modified
        direction: DESC
    limit: 24
  - type: table
    name: Tabela
    order:
      - file.name
      - formula.Data
      - description
    sort:
      - property: formula.Data
        direction: DESC
    limit: 20
